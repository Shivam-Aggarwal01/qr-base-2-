rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    function role() {
      return signedIn() && exists(userDocPath())
        ? get(userDocPath()).data.role
        : null;
    }
    function isAdmin() {
      return signedIn() &&
        request.auth.token.role == 'ADMIN';
    }
    function isStaff() {
      return signedIn() &&
        request.auth.token.role in [
          'ADMIN',
          'STUDENT_LEAD',
          'STUDENT_AMBASSADOR'
        ];
    }
    function isStudent() {
      return signedIn() &&
        request.auth.token.role == 'STUDENT';
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isStaff());
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          exists(/databases/$(database)/documents/account_requests/$(userId)) &&
          get(/databases/$(database)/documents/account_requests/$(userId)).data.status == 'APPROVED'
        )
      );
      allow update: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&
          request.resource.data.role == resource.data.role
        );
      allow delete: if isAdmin();
    }

    match /account_requests/{requestId} {
      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.status == 'PENDING';
      allow read: if signedIn() &&
        (request.auth.uid == requestId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /catalog_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /stock_levels/{stockId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /asset_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /requests/{requestId} {
      allow read: if signedIn() &&
        (request.auth.uid == resource.data.user_id || isStaff());
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.user_id;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /requests/{requestId}/request_items/{requestItemId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        request.auth.uid ==
          get(/databases/$(database)/documents/requests/$(requestId)).data.user_id ||
        isStaff()
      );
      allow update, delete: if isStaff();
    }

    match /inventory_transactions/{txId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }
  }
}
