rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(userDocPath())
        ? get(userDocPath()).data.role
        : null;
    }

    function isAdminEmail() {
      return signedIn() && request.auth.token.email != null && (
        request.auth.token.email.matches('(?i)^shivamafterall111@gmail\\.com$') ||
        request.auth.token.email.matches('(?i)^mohitdavar2004@gmail\\.com$')
      );
    }

    // Admin level: hardcoded emails must win even if the users/{uid} doc is missing.
    function isAdmin() {
      return isAdminEmail() || role() == 'ADMIN';
    }

    // Staff level (STUDENT_AMBASSADOR, STUDENT_LEAD): Can issue inventory, manage catalog, approve requests
    function isStaff() {
      return isAdmin() || (signedIn() && role() in ['STUDENT_LEAD', 'STUDENT_AMBASSADOR']);
    }

    function isStudent() {
      return isStaff() || (signedIn() && role() in ['ADMIN', 'STUDENT_LEAD', 'STUDENT_AMBASSADOR', 'STUDENT']);
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId && (
            isAdminEmail() ||
            (
              exists(/databases/$(database)/documents/account_requests/$(userId)) &&
              get(/databases/$(database)/documents/account_requests/$(userId)).data.status == 'APPROVED'
            )
          )
        )
      );
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /account_requests/{requestId} {
      allow create: if signedIn()
        && request.auth.uid == requestId
        && request.resource.data.status == 'PENDING';
      allow read: if signedIn() && (request.auth.uid == requestId || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /catalog_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /stock_levels/{stockId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /asset_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /requests/{requestId} {
      // Users can see their own requests; staff can see all
      allow read: if signedIn() && (request.auth.uid == resource.data.user_id || isStaff());
      // Students can submit their own requests
      allow create: if isStudent() && request.auth.uid == request.resource.data.user_id;
      // Only staff can update status (approve, partial, complete)
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /requests/{requestId}/request_items/{requestItemId} {
      allow read: if signedIn();
      allow create: if isStudent() && (
        request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.user_id ||
        isStaff()
      );
      allow update, delete: if isStaff();
    }

    match /inventory_transactions/{txId} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if signedIn();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }
  }
}
