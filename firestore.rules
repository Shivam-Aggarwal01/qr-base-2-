rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Authentication and roles
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn()
        ? (
            'role' in request.auth.token
              ? request.auth.token.role
              : (
                  exists(userDocPath())
                    ? get(userDocPath()).data.role
                    : null
                )
          )
        : null;
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isStaff() {
      return role() in [
        'ADMIN',
        'INSTITUTION_MANAGER',
        'STUDENT_LEAD',
        'STUDENT_AMBASSADOR'
      ];
    }

    function isResourceOwner() {
      return role() == 'RESOURCE_OWNER';
    }

    function ownsResource(assetId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/assets/$(assetId)) &&
        get(/databases/$(database)/documents/assets/$(assetId)).data.owner_id == request.auth.uid;
    }

    function meetsResourceRequirements(assetId) {
      let resourceData = get(
        /databases/$(database)/documents/assets/$(assetId)
      ).data;
      return (
          !('eligibility_requirements' in resourceData) ||
          resourceData.eligibility_requirements == '' ||
          (
            resourceData.eligible_user_ids is list &&
            request.auth.uid in resourceData.eligible_user_ids
          )
        ) &&
        (
          !('training_requirements' in resourceData) ||
          resourceData.training_requirements == '' ||
          (
            resourceData.trained_user_ids is list &&
            request.auth.uid in resourceData.trained_user_ids
          )
        );
    }
    function isStudent() {
      return role() == 'STUDENT';
    }


    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      // Users can read themselves.
      // Staff can read all users.
      allow read: if signedIn() &&
        (
          request.auth.uid == userId ||
          isStaff()
        );

      // Admin can create any user.
      //
      // A student can create only their own profile after
      // their account request has been approved.
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&

          exists(
            /databases/$(database)/documents/account_requests/$(userId)
          ) &&

          get(
            /databases/$(database)/documents/account_requests/$(userId)
          ).data.status == 'APPROVED' &&

          request.resource.data.role == 'STUDENT'
        )
      );

      // Admin can update any user.
      //
      // Non-admin users can update only their own profile.
      // They cannot change role, email.
      allow update: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&

          request.resource.data.role == resource.data.role &&
          request.resource.data.email == resource.data.email
        );

      // Only admins can delete users.
      allow delete: if isAdmin();
    }


    // ============================================================
    // Account Requests
    // ============================================================

    match /account_requests/{requestId} {

      // A signed-in user can create their own request.
      //
      // The request must start as PENDING.
      allow create: if signedIn() &&
        request.auth.uid == requestId &&
        request.resource.data.status == 'PENDING';

      // A student can read only their own request.
      // Admins can read all requests.
      allow read: if signedIn() &&
        (
          request.auth.uid == requestId ||
          isAdmin() ||
          role() == 'INSTITUTION_MANAGER'
        );

      // Only admins can approve, reject, or otherwise modify
      // an account request.
      allow update: if isAdmin() || role() == 'INSTITUTION_MANAGER';

      // Only admins can delete requests.
      allow delete: if isAdmin();
    }


    // ============================================================
    // Catalog Items
    // ============================================================

    match /catalog_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Locations
    // ============================================================

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Stock Levels
    // ============================================================

    match /stock_levels/{stockId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Assets
    // ============================================================

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create: if isStaff() ||
        (isResourceOwner() && signedIn() && request.resource.data.owner_id == request.auth.uid);
      allow update: if isStaff() ||
        (
          isResourceOwner() &&
          resource.data.owner_id == request.auth.uid &&
          request.resource.data.owner_id == resource.data.owner_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'description',
            'category',
            'institution',
            'image_urls',
            'eligibility_requirements',
            'eligible_user_ids',
            'training_requirements',
            'trained_user_ids',
            'safety_instructions',
            'usage_restrictions',
            'approval_required',
            'booking_slot_minutes',
            'max_consecutive_bookings',
            'status',
            'assigned_to_user_id',
            'location_id',
            'checkout_location_id',
            'storage_location',
            'notes',
            'asset_code',
            'qr_code',
            'updated_at'
          ])
        ) ||
        (
          isResourceOwner() &&
          resource.data.owner_id == request.auth.uid &&
          request.resource.data.booking_revision ==
            resource.data.get('booking_revision', 0) + 1 &&
          request.resource.data.last_booking_id is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'booking_revision',
            'last_booking_id',
            'updated_at'
          ]) &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.resource_asset_id == assetId &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.status == 'APPROVED' &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.approved_by_user_id == request.auth.uid
        ) ||
        (
          signedIn() &&
          role() == 'STUDENT' &&
          request.resource.data.booking_revision ==
            resource.data.get('booking_revision', 0) + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'booking_revision',
            'last_booking_id',
            'updated_at'
          ]) &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.user_id == request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.resource_asset_id == assetId &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.status in ['PENDING', 'WAITLISTED', 'APPROVED']
        ) ||
        (
          signedIn() &&
          role() == 'STUDENT' &&
          request.resource.data.last_booking_id is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'assigned_to_user_id',
            'location_id',
            'checkout_location_id',
            'last_booking_id',
            'updated_at'
          ]) &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.user_id == request.auth.uid &&
          getAfter(
            /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
          ).data.resource_asset_id == assetId &&
          (
            (
              resource.data.status == 'AVAILABLE' &&
              request.resource.data.status == 'ISSUED' &&
              request.resource.data.assigned_to_user_id == request.auth.uid &&
              getAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
              ).data.status == 'CHECKED_IN'
            ) ||
            (
              resource.data.status == 'ISSUED' &&
              request.resource.data.status == 'ISSUED' &&
              resource.data.assigned_to_user_id == request.auth.uid &&
              getAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.last_booking_id)
              ).data.status == 'RETURNED'
            )
          )
        );
      allow delete: if isStaff() || (isResourceOwner() && resource.data.owner_id == request.auth.uid);
    }


    // ============================================================
    // Asset Assignments
    // ============================================================

    match /asset_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Requests
    // ============================================================

    match /requests/{requestId} {

      // Staff can read all requests.
      //
      // Students can read only requests belonging to them.
      allow read: if isStaff() ||
        (
          signedIn() &&
          (
            resource.data.user_id == request.auth.uid ||
            ownsResource(resource.data.resource_asset_id)
          )
        );

      // A signed-in user can create only their own request.
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.user_id &&
        (
          !('resource_asset_id' in request.resource.data) ||
          (
            request.resource.data.status in ['PENDING', 'WAITLISTED', 'APPROVED'] &&
            request.resource.data.booking_start_at is timestamp &&
            request.resource.data.booking_end_at is timestamp &&
            request.time < request.resource.data.booking_start_at &&
            request.resource.data.booking_end_at > request.resource.data.booking_start_at &&
            exists(/databases/$(database)/documents/assets/$(request.resource.data.resource_asset_id)) &&
            meetsResourceRequirements(request.resource.data.resource_asset_id) &&
            getAfter(
              /databases/$(database)/documents/assets/$(request.resource.data.resource_asset_id)
            ).data.last_booking_id == requestId &&
            getAfter(
              /databases/$(database)/documents/assets/$(request.resource.data.resource_asset_id)
            ).data.booking_revision ==
              get(/databases/$(database)/documents/assets/$(request.resource.data.resource_asset_id)).data.get('booking_revision', 0) + 1
          )
        );

      // Students can request a return for their own issued request.
      // Staff must still confirm receipt and complete the return.
      allow update: if isStaff() ||
        (
          isResourceOwner() &&
          ownsResource(resource.data.resource_asset_id) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'approved_by_user_id',
            'return_verified_by_user_id',
            'completed_at',
            'remarks',
            'updated_at'
          ]) &&
          (
            (
              resource.data.status in ['PENDING', 'WAITLISTED'] &&
              request.resource.data.status in ['APPROVED', 'REJECTED', 'WAITLISTED'] &&
              request.resource.data.approved_by_user_id == request.auth.uid
            ) ||
            (
              resource.data.status in ['RETURNED', 'UNDER_REVIEW'] &&
              request.resource.data.status == 'COMPLETED' &&
              request.resource.data.return_verified_by_user_id == request.auth.uid &&
              getAfter(
                /databases/$(database)/documents/assets/$(resource.data.resource_asset_id)
              ).data.status == (resource.data.damage_reported == true ? 'DAMAGED' : 'AVAILABLE')
            )
          )
        ) ||
        (
          isStudent() &&
          resource.data.user_id == request.auth.uid &&
          (
            (
              resource.data.resource_asset_id is string &&
              resource.data.status == 'APPROVED' &&
              request.time >= resource.data.booking_start_at - duration.value(15, 'm') &&
              request.time <= resource.data.booking_end_at &&
              meetsResourceRequirements(resource.data.resource_asset_id) &&
              request.resource.data.status == 'CHECKED_IN' &&
              request.resource.data.initial_condition is string &&
              request.resource.data.initial_condition.size() > 0 &&
              getAfter(
                /databases/$(database)/documents/assets/$(resource.data.resource_asset_id)
              ).data.status == 'ISSUED' &&
              getAfter(
                /databases/$(database)/documents/assets/$(resource.data.resource_asset_id)
              ).data.assigned_to_user_id == request.auth.uid &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'checked_in_at',
                'initial_condition',
                'updated_at'
              ])
            ) ||
            (
              resource.data.resource_asset_id is string &&
              resource.data.status == 'CHECKED_IN' &&
              request.resource.data.status == 'RETURNED' &&
              request.resource.data.final_condition is string &&
              request.resource.data.final_condition.size() > 0 &&
              request.resource.data.damage_reported is bool &&
              getAfter(
                /databases/$(database)/documents/assets/$(resource.data.resource_asset_id)
              ).data.status == 'ISSUED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'checked_out_at',
                'final_condition',
                'damage_reported',
                'updated_at'
              ])
            ) ||
            (
              resource.data.resource_asset_id == null &&
              resource.data.status in ['HANDED_OVER', 'APPROVED'] &&
              request.resource.data.status == 'RETURN_REQUESTED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'updated_at'
              ])
            ) ||
            (
              resource.data.status in ['PENDING', 'APPROVED', 'WAITLISTED'] &&
              request.resource.data.status == 'CANCELLED' &&
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status',
                'updated_at'
              ])
            )
          )
        );

      // Only admins can delete requests.
      allow delete: if isAdmin();
    }

    match /resource_bookings/{bookingId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        existsAfter(/databases/$(database)/documents/requests/$(bookingId)) &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.user_id == request.auth.uid &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.resource_asset_id == request.resource.data.resource_id &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.booking_start_at == request.resource.data.starts_at &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.booking_end_at == request.resource.data.ends_at &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.status == request.resource.data.status;
      allow update: if signedIn() &&
        request.resource.data.booking_id == resource.data.booking_id &&
        request.resource.data.resource_id == resource.data.resource_id &&
        request.resource.data.starts_at == resource.data.starts_at &&
        request.resource.data.ends_at == resource.data.ends_at &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at']) &&
        existsAfter(/databases/$(database)/documents/requests/$(bookingId)) &&
        getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.status == request.resource.data.status &&
        (
          isStaff() ||
          ownsResource(resource.data.resource_id) ||
          getAfter(/databases/$(database)/documents/requests/$(bookingId)).data.user_id == request.auth.uid
        );
      allow delete: if false;
    }


    // ============================================================
    // Request Items
    // ============================================================

    match /requests/{requestId}/request_items/{requestItemId} {

      // Staff can read all request items.
      //
      // Students can read items only from their own request.
      allow read: if isStaff() ||
        (
          signedIn() &&
          get(
            /databases/$(database)/documents/requests/$(requestId)
          ).data.user_id == request.auth.uid
        );

      // Request owner or staff can add request items.
      allow create: if signedIn() && (
        isStaff() ||
        get(
          /databases/$(database)/documents/requests/$(requestId)
        ).data.user_id == request.auth.uid
      );

      // Staff manage request items.
      allow update, delete: if isStaff();
    }


    // ============================================================
    // Inventory Transactions
    // ============================================================

    match /inventory_transactions/{txId} {

      // Historical inventory transactions are readable by staff.
      allow read: if isStaff();

      // Staff may create historical entries; entries are immutable afterward.
      allow create: if isStaff();
      allow update, delete: if false;
    }


    // ============================================================
    // Audit Logs
    // ============================================================

    match /audit_logs/{logId} {

      // Staff can read audit logs.
      allow read: if isStaff();

      // Audit logs must be written by trusted backend code.
      allow create, update, delete: if false;
    }

    match /resource_events/{eventId} {
      allow read: if isStaff() ||
        (signedIn() && ownsResource(resource.data.resource_id)) ||
        (
            signedIn() &&
            resource.data.booking_id is string &&
            get(
              /databases/$(database)/documents/requests/$(resource.data.booking_id)
            ).data.user_id == request.auth.uid
        );
      allow create: if signedIn() &&
        request.resource.data.actor_user_id == request.auth.uid &&
        request.resource.data.resource_id is string &&
        (
            (
              request.resource.data.action == 'RESOURCE_CREATED' &&
              getAfter(
                /databases/$(database)/documents/assets/$(request.resource.data.resource_id)
              ).data.owner_id == request.auth.uid
            ) ||
            (
              request.resource.data.booking_id is string &&
              existsAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
              ) &&
              getAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
              ).data.resource_asset_id == request.resource.data.resource_id &&
              (
                (
                  request.resource.data.action == 'BOOKING_REQUESTED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status in ['PENDING', 'WAITLISTED', 'APPROVED']
                ) ||
                (
                  request.resource.data.action == 'BOOKING_APPROVED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.approved_by_user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'APPROVED'
                ) ||
                (
                  request.resource.data.action == 'BOOKING_REJECTED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.approved_by_user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'REJECTED'
                ) ||
                (
                  request.resource.data.action == 'BOOKING_WAITLISTED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.approved_by_user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'WAITLISTED'
                ) ||
                (
                  request.resource.data.action == 'BOOKING_CANCELLED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'CANCELLED'
                ) ||
                (
                  request.resource.data.action == 'CHECK_IN' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'CHECKED_IN'
                ) ||
                (
                  request.resource.data.action == 'CHECK_OUT' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'RETURNED'
                ) ||
                (
                  request.resource.data.action == 'RETURN_VERIFIED' &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.return_verified_by_user_id == request.auth.uid &&
                  getAfter(
                    /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
                  ).data.status == 'COMPLETED'
                )
            )
          )
        );
      allow update, delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.actor_user_id == request.auth.uid &&
        request.resource.data.booking_id is string &&
        request.resource.data.resource_id is string &&
        existsAfter(
          /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
        ) &&
        getAfter(
          /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
        ).data.resource_asset_id == request.resource.data.resource_id &&
        (
          (
            request.resource.data.type == 'BOOKING_REQUEST' &&
            getAfter(
              /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
            ).data.user_id == request.auth.uid &&
            getAfter(
              /databases/$(database)/documents/assets/$(request.resource.data.resource_id)
            ).data.owner_id == request.resource.data.user_id
          ) ||
          (
            request.resource.data.type in ['BOOKING_APPROVED', 'BOOKING_REJECTED', 'BOOKING_WAITLISTED', 'RETURN_VERIFIED'] &&
            getAfter(
              /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
            ).data.user_id == request.resource.data.user_id &&
            (
              getAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
              ).data.approved_by_user_id == request.auth.uid ||
              getAfter(
                /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
              ).data.return_verified_by_user_id == request.auth.uid
            )
          ) ||
          (
            request.resource.data.type in ['CHECK_IN', 'CHECK_OUT'] &&
            getAfter(
              /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
            ).data.user_id == request.auth.uid &&
            getAfter(
              /databases/$(database)/documents/assets/$(request.resource.data.resource_id)
            ).data.owner_id == request.resource.data.user_id
          ) ||
          (
            request.resource.data.type == 'BOOKING_CANCELLED' &&
            getAfter(
              /databases/$(database)/documents/assets/$(request.resource.data.resource_id)
            ).data.owner_id == request.resource.data.user_id &&
            getAfter(
              /databases/$(database)/documents/requests/$(request.resource.data.booking_id)
            ).data.user_id == request.auth.uid
          )
        );
      allow update: if signedIn() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }
  }
}
