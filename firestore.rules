rules_version = '2';
service cloud.firestore {
  function signedIn() {
    return request.auth != null;
  }

  function role() {
    return request.auth.token.role;
  }

  function userRole() {
    return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : null;
  }

  function isAdmin() {
    return signedIn() && (role() == 'ADMIN' || userRole() == 'ADMIN');
  }

  function isAmbassador() {
    return signedIn() && (
      role() == 'ADMIN' ||
      role() == 'STUDENT_AMBASSADOR' ||
      role() == 'STUDENT_LEAD' ||
      userRole() == 'ADMIN' ||
      userRole() == 'STUDENT_AMBASSADOR' ||
      userRole() == 'STUDENT_LEAD'
    );
  }

  // Staff who can approve and issue/return inventory.
  function isStaff() {
    return isAmbassador();
  }

  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /catalog_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isAmbassador();
    }

    match /stock_levels/{stockId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isAmbassador();
    }

    match /asset_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isAmbassador();
    }

    match /requests/{requestId} {
      allow read: if signedIn() && (
        // Students can only see their own requests.
        request.auth.uid == resource.data.user_id ||
        // Staff can see all requests.
        isStaff()
      );

      // Students can submit their own requests only.
      allow create: if signedIn() && request.auth.uid == request.resource.data.user_id;

      // Only staff can approve/complete/cancel and otherwise mutate request state.
      allow update: if signedIn() && isStaff();

      // Only admins should be able to delete requests.
      allow delete: if signedIn() && isAdmin();
    }

    match /requests/{requestId}/request_items/{requestItemId} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        // Owner can create items as part of their request.
        request.auth.uid == get(/databases/$(database)/documents/requests/$(requestId)).data.user_id ||
        isStaff()
      );

      // Only staff should be able to update/delete request items.
      allow update, delete: if signedIn() && isStaff();
    }

    match /inventory_transactions/{txId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isAdmin() || isAmbassador());
      allow update, delete: if isAdmin();
    }

    match /audit_logs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && (isAdmin() || isAmbassador());
      allow update, delete: if isAdmin();
    }
  }
}
