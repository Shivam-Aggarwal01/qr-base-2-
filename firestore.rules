rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Authentication and roles
    // ============================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn()
        ? (
            request.auth.token.get('role', null) != null
              ? request.auth.token.get('role', null)
              : (
                  exists(userDocPath())
                    ? get(userDocPath()).data.role
                    : null
                )
          )
        : null;
    }

    function isAdmin() {
      return role() == 'ADMIN';
    }

    function isStaff() {
      return role() in [
        'ADMIN',
        'STUDENT_LEAD',
        'STUDENT_AMBASSADOR'
      ];
    }

    function isStudent() {
      return role() == 'STUDENT';
    }


    // ============================================================
    // Users
    // ============================================================

    match /users/{userId} {

      // Users can read themselves.
      // Staff can read all users.
      allow read: if signedIn() &&
        (
          request.auth.uid == userId ||
          isStaff()
        );

      // Admin can create any user.
      //
      // A student can create only their own profile after
      // their account request has been approved.
      allow create: if signedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId &&

          exists(
            /databases/$(database)/documents/account_requests/$(userId)
          ) &&

          get(
            /databases/$(database)/documents/account_requests/$(userId)
          ).data.status == 'APPROVED' &&

          request.resource.data.role == 'STUDENT'
        )
      );

      // Admin can update any user.
      //
      // Non-admin users can update only their own profile.
      // They cannot change role, email, or status.
      allow update: if isAdmin() ||
        (
          signedIn() &&
          request.auth.uid == userId &&

          request.resource.data.role == resource.data.role &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.status == resource.data.status
        );

      // Only admins can delete users.
      allow delete: if isAdmin();
    }


    // ============================================================
    // Account Requests
    // ============================================================

    match /account_requests/{requestId} {

      // A signed-in user can create their own request.
      //
      // The request must start as PENDING.
      allow create: if signedIn() &&
        request.auth.uid == requestId &&
        request.resource.data.status == 'PENDING';

      // A student can read only their own request.
      // Admins can read all requests.
      allow read: if signedIn() &&
        (
          request.auth.uid == requestId ||
          isAdmin()
        );

      // Only admins can approve, reject, or otherwise modify
      // an account request.
      allow update: if isAdmin();

      // Only admins can delete requests.
      allow delete: if isAdmin();
    }


    // ============================================================
    // Catalog Items
    // ============================================================

    match /catalog_items/{itemId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Locations
    // ============================================================

    match /locations/{locationId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Stock Levels
    // ============================================================

    match /stock_levels/{stockId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Assets
    // ============================================================

    match /assets/{assetId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Asset Assignments
    // ============================================================

    match /asset_assignments/{assignmentId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    // ============================================================
    // Requests
    // ============================================================

    match /requests/{requestId} {

      // Staff can read all requests.
      //
      // Students can read only requests belonging to them.
      allow read: if isStaff() ||
        (
          signedIn() &&
          resource.data.user_id == request.auth.uid
        );

      // A signed-in user can create only their own request.
      allow create: if signedIn() &&
        request.auth.uid == request.resource.data.user_id;

      // Students can request a return for their own issued request.
      // Staff must still confirm receipt and complete the return.
      allow update: if isStaff() ||
        (
          isStudent() &&
          resource.data.user_id == request.auth.uid &&
          resource.data.status in ['HANDED_OVER', 'APPROVED'] &&
          request.resource.data.status == 'RETURN_REQUESTED' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status',
            'updated_at'
          ])
        );

      // Only admins can delete requests.
      allow delete: if isAdmin();
    }


    // ============================================================
    // Request Items
    // ============================================================

    match /requests/{requestId}/request_items/{requestItemId} {

      // Staff can read all request items.
      //
      // Students can read items only from their own request.
      allow read: if isStaff() ||
        (
          signedIn() &&
          get(
            /databases/$(database)/documents/requests/$(requestId)
          ).data.user_id == request.auth.uid
        );

      // Request owner or staff can add request items.
      allow create: if signedIn() && (
        isStaff() ||
        get(
          /databases/$(database)/documents/requests/$(requestId)
        ).data.user_id == request.auth.uid
      );

      // Staff manage request items.
      allow update, delete: if isStaff();
    }


    // ============================================================
    // Inventory Transactions
    // ============================================================

    match /inventory_transactions/{txId} {

      // Historical inventory transactions are readable by staff.
      allow read: if isStaff();

      // Staff may create historical entries; entries are immutable afterward.
      allow create: if isStaff();
      allow update, delete: if false;
    }


    // ============================================================
    // Audit Logs
    // ============================================================

    match /audit_logs/{logId} {

      // Staff can read audit logs.
      allow read: if isStaff();

      // Audit logs must be written by trusted backend code.
      allow create, update, delete: if false;
    }
  }
}
